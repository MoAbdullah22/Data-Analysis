digraph roadmap {
  rankdir=LR; bgcolor="white"; nodesep=0.28; ranksep=1.1; fontname="Helvetica"; labelloc=t; fontsize=24;
  label=<<B>Project Roadmap</B>  <FONT POINT-SIZE="15">E-Commerce SQL Data Analytics  |  Author: Mohamed Abdullah Ali</FONT><BR/> >;
  node [fontname="Helvetica" fontsize=13 shape=box style="rounded,filled" margin="0.18,0.10"];
  edge [color="#777777" penwidth=1.6 arrowsize=0.8];

  root [label=<<B><FONT POINT-SIZE="20">Data Analytics</FONT></B>> shape=ellipse fillcolor="#EEEEEE" color="#555555" penwidth=2];

  eda [label=<<B><FONT POINT-SIZE="17">Exploratory Data Analysis</FONT></B><BR/>(EDA)  -  understand the data> shape=ellipse fillcolor="#E3ECFA" color="#6c8ebf" penwidth=2];
  adv [label=<<B><FONT POINT-SIZE="17">Advanced Analytics</FONT></B><BR/>answer business questions> shape=ellipse fillcolor="#E6F2DC" color="#82b366" penwidth=2];
  root -> eda [color="#6c8ebf" penwidth=2.4];
  root -> adv [color="#82b366" penwidth=2.4];

  node [fillcolor="#E3ECFA" color="#6c8ebf"];
  s1 [label=<<B>1  Database Exploration</B><BR/><FONT POINT-SIZE="11">01_database_exploration.sql</FONT>>];
  s2 [label=<<B>2  Dimensions Exploration</B><BR/><FONT POINT-SIZE="11">02_dimensions_exploration.sql</FONT>>];
  s3 [label=<<B>3  Date Exploration</B><BR/><FONT POINT-SIZE="11">03_date_range_exploration.sql</FONT>>];
  s4 [label=<<B>4  Measures Exploration</B><BR/><FONT POINT-SIZE="11">04_measures_exploration.sql  (big numbers)</FONT>>];
  s5 [label=<<B>5  Magnitude</B><BR/><FONT POINT-SIZE="11">05_magnitude_analysis.sql</FONT>>];
  s6 [label=<<B>6  Ranking</B><BR/><FONT POINT-SIZE="11">06_ranking_analysis.sql  (Top N / Bottom N)</FONT>>];
  eda -> {s1 s2 s3 s4 s5 s6};

  node [fillcolor="#E6F2DC" color="#82b366"];
  s7  [label=<<B>7  Change-Over-Time</B><BR/><FONT POINT-SIZE="11">07_change_over_time_analysis.sql  (trends)</FONT>>];
  s8  [label=<<B>8  Cumulative Analysis</B><BR/><FONT POINT-SIZE="11">08_cumulative_analysis.sql</FONT>>];
  s9  [label=<<B>9  Performance Analysis</B><BR/><FONT POINT-SIZE="11">09_performance_analysis.sql  (YoY, MoM)</FONT>>];
  s10 [label=<<B>10  Part-to-Whole</B><BR/><FONT POINT-SIZE="11">11_part_to_whole_analysis.sql  (proportional)</FONT>>];
  s11 [label=<<B>11  Data Segmentation</B><BR/><FONT POINT-SIZE="11">10_data_segmentation.sql</FONT>>];
  s12 [label=<<B>12  Reporting</B><BR/><FONT POINT-SIZE="11">12_report_customers / 13_report_products / 14_report_funnel</FONT>>];
  adv -> {s7 s8 s9 s10 s11 s12};
}
